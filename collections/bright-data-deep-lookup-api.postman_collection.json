  "info": {
    "_postman_id": "bc43cf76-3c06-4d64-8be6-c9f27c357888",
    "name": "Bright Data Deep Lookup API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Deep Lookup is an entity-research API that finds companies and professionals across 1,000+\npublic sources with 95%+ accuracy. Submit a natural-language description or structured query\nvia `POST /trigger`, preview row counts and shape with `/preview`, optimize the query with\n`/enhance_query`, enrich existing columns with `/request/{id}/enrich`, monitor with `/status`,\nand download results once ready. Billed per delivered result.\n\n\nContact Support:\n Name: Bright Data",
      "type": "text/plain"
    }
  }
