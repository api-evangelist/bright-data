      "item": [
        {
          "id": "fdaa668a-1a65-486c-b170-47c8eb45fad1",
          "name": "Trigger a Web Scraper Job",
          "request": {
            "name": "Trigger a Web Scraper Job",
            "description": {
              "content": "Trigger an asynchronous scraping job against a Bright Data dataset. Pass the `dataset_id` of\nthe target collector and the per-record input payload as a JSON array. Returns a `snapshot_id`\nused to poll progress and download results.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets",
                "v3",
                "scrape"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataset_id",
                  "value": "<string>",
                  "description": "(Required) Bright Data dataset identifier (e.g. `gd_l1viktl72bvl7bjuj0`)."
                },
                {
                  "disabled": false,
                  "key": "include_errors",
                  "value": "<boolean>"
                },
                {
                  "disabled": false,
                  "key": "notify",
                  "value": "<uri>",
                  "description": "Webhook URL Bright Data calls when the snapshot completes."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "limit_per_input",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "limit_multiple_results",
                  "value": "<integer>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"key_0\": 787.3331228084568,\n    \"key_1\": \"string\",\n    \"key_2\": \"string\"\n  },\n  {\n    \"key_0\": 9821.008032376434,\n    \"key_1\": 3660\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "id": "359d1c4b-9173-42e6-9baa-d94e5472d688",
              "name": "Job submitted.",
              "originalRequest": {
                "url": {
