{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bright Data Account Management Access Billing API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Billing",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Customer Balance",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brightdata.com/customer/balance"
          },
          "docs": "Get Customer Balance"
        },
        {
          "info": {
            "name": "Get Zone Bandwidth Usage",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brightdata.com/zone/bw",
            "params": [
              {
                "name": "zone",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query"
              },
              {
                "name": "to",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Get Zone Bandwidth Usage"
        }
      ]
    }
  ],
  "bundled": true
}