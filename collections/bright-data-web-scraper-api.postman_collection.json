      },
      "item": [
        {
          "id": "2914cc29-be61-480f-8fc2-5500227bdbb9",
          "name": "Trigger a Web Scraper Job",
          "request": {
            "name": "Trigger a Web Scraper Job",
            "description": {
              "content": "Trigger an asynchronous scraping job against a Bright Data dataset. Pass the `dataset_id` of\nthe target collector and the per-record input payload as a JSON array. Returns a `snapshot_id`\nused to poll progress and download results.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "datasets",
                "v3",
                "scrape"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "dataset_id",
                  "value": "<string>",
                  "description": "(Required) Bright Data dataset identifier (e.g. `gd_l1viktl72bvl7bjuj0`)."
                },
                {
                  "disabled": false,
                  "key": "include_errors",
                  "value": "<boolean>"
                },
                {
                  "disabled": false,
                  "key": "notify",
                  "value": "<uri>",
                  "description": "Webhook URL Bright Data calls when the snapshot completes."
                },
                {
                  "disabled": false,
                  "key": "format",
                  "value": "<string>"
                },
                {
                  "disabled": false,
                  "key": "limit_per_input",
                  "value": "<integer>"
                },
                {
                  "disabled": false,
                  "key": "limit_multiple_results",
                  "value": "<integer>"
                }
              ],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "[\n  {\n    \"key_0\": \"string\"\n  },\n  {\n    \"key_0\": 6812.015303472582,\n    \"key_1\": \"string\",\n    \"key_2\": false,\n    \"key_3\": 3888,\n    \"key_4\": false\n  }\n]",
              "options": {
                "raw": {
                  "language": "json"
