  "info": {
    "_postman_id": "f60cbe52-43a9-4f2c-9885-e3210687b026",
    "name": "Bright Data Scraping Browser API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Scraping Browser provides fully managed remote Chromium browsers controlled via CDP/WebSocket\nfrom Puppeteer, Playwright, or Selenium. The browser session includes built-in unlocker logic,\nresidential proxy egress, CAPTCHA solving, and fingerprint management.\n\nDriver control happens over WebSocket. This REST surface exposes session inventory and lifecycle\ninspection for observability and management.\n\n\nContact Support:\n Name: Bright Data",
      "type": "text/plain"
    }
  }
