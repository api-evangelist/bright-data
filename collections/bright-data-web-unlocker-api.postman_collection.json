  "info": {
    "_postman_id": "ed12b002-fba8-4583-a14d-1e308933f7d4",
    "name": "Bright Data Web Unlocker API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "Web Unlocker is a single-endpoint unblocking service. Submit any target URL and Bright Data\nhandles residential proxy selection, JavaScript rendering, CAPTCHA solving, fingerprint\nmanagement, and anti-bot evasion, returning the fully rendered response. Supports both\nsynchronous (one-shot) and asynchronous (submit + poll) modes.\n\nAuthentication uses a Bearer API token. Successful requests only — failed unlocks are not billed.\n\n\nContact Support:\n Name: Bright Data",
      "type": "text/plain"
    }
  }
