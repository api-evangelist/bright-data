              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deliver Snapshot to Cloud"
        },
        {
          "info": {
            "name": "Deliver Snapshot to Cloud Storage",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.brightdata.com/datasets/v3/snapshot/:snapshot_id/deliver",
            "params": [
              {
                "name": "snapshot_id",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Deliver Snapshot to Cloud Storage"
        }
      ]
    }
  ],
  "bundled": true
}