  "info": {
    "_postman_id": "193e96dd-46bb-481d-89f7-9e7bcea2f3e4",
    "name": "Bright Data Web Archive API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": {
      "content": "The Web Archive API exposes Bright Data's petabyte-scale historical web index across 250+ domains.\nSubmit a search via `POST /webarchive/search`, monitor with `GET /webarchive/search/{search_id}`,\nlist all searches via `GET /webarchive/searches`, and deliver matching corpora to S3/Azure/GCS\nvia `POST /webarchive/deliver-to-cloud`.\n\n\nContact Support:\n Name: Bright Data",
      "type": "text/plain"
    }
  }
