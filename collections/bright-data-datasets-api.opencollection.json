{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bright Data Account Management Access Datasets API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Datasets",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List Marketplace Datasets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brightdata.com/datasets"
          },
          "docs": "List Marketplace Datasets"
        },
        {
          "info": {
            "name": "Get Dataset Metadata",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.brightdata.com/datasets/:dataset_id/metadata",
            "params": [
              {
                "name": "dataset_id",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get Dataset Metadata"
        }
      ]
    }
  ],
  "bundled": true
}