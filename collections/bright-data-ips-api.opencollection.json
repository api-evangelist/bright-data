              },
              {
                "name": "ips",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Remove IPs from Zone"
        },
        {
          "info": {
            "name": "Refresh Zone IPs",
            "type": "http"
          },
          "http": {
            "method": "POST",
