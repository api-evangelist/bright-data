            "url": "https://api.brightdata.com/zone/ips",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Add IPs to Zone"
        },
        {
          "info": {
            "name": "Remove IPs from Zone",
            "type": "http"
          },
          "http": {
