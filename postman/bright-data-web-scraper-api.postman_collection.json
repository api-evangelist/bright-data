{
  "info": {
    "_postman_id": "6ad8aaaf-9c81-47ad-88e0-15136f848720",
    "name": "Bright Data Web Scraper API",
    "description": "Bright Data's Web Scraper API exposes asynchronous scraping jobs (snapshots) backed by 660+\npre-built dataset endpoints plus custom collectors. Trigger a scrape, poll progress, list snapshots,\ncancel or rerun, and download results in JSON, NDJSON, CSV, or JSONL \u2014 optionally compressed.\nSnapshots can be pushed to S3, Azure Blob, GCS, Snowflake, or a webhook.\n\nAuthentication uses a Bearer API token issued from the Bright Data control panel.\n\n\nContact Support:\n Name: Bright Data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:05:58.000Z",
    "updatedAt": "2026-06-05T15:05:58.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-6ad8aaaf-9c81-47ad-88e0-15136f848720"
  },
