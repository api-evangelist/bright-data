    "_postman_id": "e151e979-52fd-48f9-bb1b-71b6348734a3",
    "name": "Bright Data Web Unlocker API",
    "description": "Web Unlocker is a single-endpoint unblocking service. Submit any target URL and Bright Data\nhandles residential proxy selection, JavaScript rendering, CAPTCHA solving, fingerprint\nmanagement, and anti-bot evasion, returning the fully rendered response. Supports both\nsynchronous (one-shot) and asynchronous (submit + poll) modes.\n\nAuthentication uses a Bearer API token. Successful requests only \u2014 failed unlocks are not billed.\n\n\nContact Support:\n Name: Bright Data",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-06-05T15:05:56.000Z",
    "updatedAt": "2026-06-05T15:05:56.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-e151e979-52fd-48f9-bb1b-71b6348734a3"
  },
